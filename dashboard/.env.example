# Copy to .env.local and fill from Firebase console > Project settings > Your apps > Web app.
# These values are not secrets (they ship to the browser); security comes from the Rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Set to "true" to talk to the local emulators instead of the real project.
VITE_USE_EMULATORS=false
